# Variables PUBLIQUES (exposées au navigateur) : versionnées dans .env
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=

# Variables SERVEUR (secrets) : jamais dans .env (versionné).
# En local : .env.local (ignoré par git). En production : secrets de l'hébergeur (Lovable Cloud…).

# Fournisseur IA : "lovable" (défaut) ou "anthropic"
AI_PROVIDER=lovable
# Modèle (optionnel, sinon défaut du fournisseur)
AI_MODEL=
LOVABLE_API_KEY=
ANTHROPIC_API_KEY=
